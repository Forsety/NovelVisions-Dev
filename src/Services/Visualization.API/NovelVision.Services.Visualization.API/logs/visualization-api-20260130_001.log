e93c39","ChapterId":null,"ContextBefore":"Chapter 1Chapter 1❧","ContextAfter":"✨Select any passage of text to create an AI visualization","PreferredProvider":"DallE3","Parameters":null,"$type":"CreateTextSelectionVisualizationCommand"}
